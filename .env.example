LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting (puzzles per day per IP, 0 = unlimited)
RATE_LIMIT_PER_DAY=5

# Google AdSense publisher ID (e.g., ca-pub-1234567890)
ADSENSE_PUBLISHER_ID=

# LLM reliability
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated models tried in order on retries when the primary fails (blank = disabled)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# After the Google Search quota is hit, skip search for this many seconds
GEMINI_SEARCH_COOLDOWN_SECONDS=600
CLAUDE_MODEL=claude-sonnet-4-20250514
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
